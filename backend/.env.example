# Basic
PORT=3000

# DB
PRISMA_DATABASE_URL="postgresql://codelab_site:troque-esta-senha@postgres:5432/postgres?schema=public&connect_timeout=300"

# PG WEB
PGWEB_DATABASE_URL="postgres://codelab_site:troque-esta-senha@postgres:5432/postgres?sslmode=disable"

# API Key: protege as rotas de escrita (POST/PATCH/DELETE).
# Usada pelo painel de administração (Retool) no header "Authorization: Bearer <chave>".
# Em produção, use uma chave longa e aleatória (ex.: openssl rand -hex 32).
API_KEY="secret"

# Postgres
# Em produção, use usuário e senha próprios e fortes. Nunca os valores deste exemplo.
POSTGRES_USER=codelab_site
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=postgres